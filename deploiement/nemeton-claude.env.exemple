# Configuration du connecteur nemeton distant (voir ?nemetonclaude::config_distant).
# Copier en /etc/nemeton-claude.env (droits 600, proprietaire nemeton).

# URL publique, telle que claude.ai la joint (sans /mcp).
NEMETON_CLAUDE_URL=https://nemeton.example.org
# Realm Keycloak qui delivre les jetons (meme variable que nemetonshiny).
NEMETON_KEYCLOAK_URL=https://auth.example.org/realms/nemeton
# Audience attendue dans les jetons (mappeur du client nemeton-claude).
NEMETON_CLAUDE_AUDIENCE=nemeton-claude
# Cle des liens de telechargement : openssl rand -hex 32
NEMETON_CLAUDE_SECRET=
# Roles Keycloak (realm) : lecture, et ecriture (creer, calculer, exporter).
NEMETON_CLAUDE_ROLES_LECTURE=lecteur,gestionnaire,admin
NEMETON_CLAUDE_ROLES_ECRITURE=gestionnaire,admin
# collectif : tous les comptes voient les memes projets (comme nemetonshiny).
# utilisateur : un dossier de projets par compte.
NEMETON_CLAUDE_ISOLATION=collectif
NEMETON_CLAUDE_PORT=8765
# Dossier des projets nemeton, et des fichiers ecrits pour les vues.
NEMETON_PROJECT_DIR=/srv/nemeton/projets
NEMETON_CLAUDE_VUES_DIR=/srv/nemeton/vues
LANG=C.UTF-8
